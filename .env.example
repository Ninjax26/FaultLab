FAULTLAB_ENVIRONMENT=development
FAULTLAB_DATABASE_URL=postgresql+asyncpg://faultlab:faultlab@localhost:5432/faultlab
# Change this if another local PostgreSQL service already uses port 5432.
FAULTLAB_POSTGRES_PORT=5432
FAULTLAB_LOG_LEVEL=INFO
FAULTLAB_API_HOST=0.0.0.0
FAULTLAB_API_PORT=8000
FAULTLAB_WORKER_QUEUE=default
FAULTLAB_WORKER_POLL_INTERVAL_SECONDS=1.0
FAULTLAB_WORKER_LEASE_SECONDS=30
FAULTLAB_WORKER_HEARTBEAT_SECONDS=10
FAULTLAB_WORKER_METRICS_PORT=9100
FAULTLAB_RETRY_BASE_SECONDS=2
FAULTLAB_RETRY_MAX_SECONDS=300
# Example: http://localhost:4318/v1/traces
FAULTLAB_OTEL_EXPORTER_OTLP_ENDPOINT=
